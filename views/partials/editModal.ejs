<div class="modal-overlay" id="editModal" style="display:none;">
    <div class="modal-card">
        <div class="modal-header">
            <h2>Taak bewerken</h2>
            <button id="closeModal">✕</button>
        </div>

        <div class="modal-body">
            <input type="hidden" id="editTaskId">

            <div class="form-group">
                <label for="editTaskTitle">Titel</label>
                <input type="text" id="editTaskTitle" placeholder="Taaknaam">
            </div>

            <div class="form-group">
                <label for="editTaskCategory">Categorie</label>

                <select id="editTaskCategory">
                    <option value="">Geen categorie</option>

                    <% categories.forEach(cat => { %>
                        <option value="<%= cat._id %>">
                            <%= cat.name %>
                        </option>
                    <% }) %>
                </select>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-sm-ghost" id="cancelEdit">Annuleren</button>
            <button class="btn-sm-primary" id="saveEdit">Opslaan</button>
        </div>
    </div>
</div>