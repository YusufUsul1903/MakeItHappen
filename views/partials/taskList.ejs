<div class="task-list-header">
    <span class="task-list-label">Taken</span>
    <span class="task-count">
        <%= tasks.length %> taak/taken
    </span>
</div>

<ul id="taskList">
    <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(task => { %>
            <li class="<%= task.completed ? 'completed' : '' %>" data-id="<%= task.id %>">
                <div class="task-info">
                    <input type="checkbox" <%= task.completed ? 'checked' : '' %>>

                    <div>
                        <span><%= task.title %></span>

                        <% if (task.category) { %>
                            <small class="task-category-label">
                                <span
                                    class="cat-dot"
                                    style="background:<%= task.category.color %>"
                                ></span>
                                <%= task.category.name %>
                            </small>
                        <% } %>
                    </div>
                </div>

                <div class="task-actions">
                    <button
                        class="btn-edit"
                        data-id="<%= task.id %>"
                        data-title="<%= task.title %>"
                        data-category="<%= task.category ? task.category.id : '' %>"
                    >
                        ✏️
                    </button>

                    <button
                        class="btn-delete"
                        data-id="<%= task.id %>"
                    >
                        🗑️
                    </button>
                </div>
            </li>
        <% }) %>
    <% } else { %>
        <p class="empty-state">Geen taken gevonden. Lekker bezig!</p>
    <% } %>
</ul>